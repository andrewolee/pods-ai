<Project DefaultTargets="Build" xmlns="http://schemas.microsoft.com/developer/msbuild/2003" ToolsVersion="4.0">
  <PropertyGroup>
    <Configuration Condition=" '$(Configuration)' == '' ">Debug</Configuration>
    <SchemaVersion>2.0</SchemaVersion>
    <ProjectGuid>374cfa2a-7626-4e39-a61f-20af1688caa5</ProjectGuid>
    <ProjectHome>.</ProjectHome>
    <StartupFile>src\compare_models.py</StartupFile>
    <SearchPath>
    </SearchPath>
    <WorkingDirectory>.</WorkingDirectory>
    <OutputPath>.</OutputPath>
    <Name>pods-ai</Name>
    <RootNamespace>pods-ai</RootNamespace>
    <LaunchProvider>Standard Python launcher</LaunchProvider>
    <!-- Command line arguments are intentionally left blank.
         Developers may customize this locally. -->
    <CommandLineArguments>
    </CommandLineArguments>
    <EnableNativeCodeDebugging>False</EnableNativeCodeDebugging>
    <IsWindowsApplication>False</IsWindowsApplication>
    <InterpreterId>MSBuild|.venv|$(MSBuildProjectFullPath)</InterpreterId>
    <Environment>MODEL_TYPE=fastai
MODEL_AUTO_DOWNLOAD=true
MODEL_URL=https://trainedproductionmodels.blob.core.windows.net/dnnmodel/11-15-20.FastAI.R1-12.zip</Environment>
    <TestFramework>Pytest</TestFramework>
  </PropertyGroup>
  <PropertyGroup Condition=" '$(Configuration)' == 'Debug' ">
    <DebugSymbols>true</DebugSymbols>
    <EnableUnmanagedDebugging>false</EnableUnmanagedDebugging>
  </PropertyGroup>
  <PropertyGroup Condition=" '$(Configuration)' == 'Release' ">
    <DebugSymbols>true</DebugSymbols>
    <EnableUnmanagedDebugging>false</EnableUnmanagedDebugging>
  </PropertyGroup>
  <ItemGroup>
    <Compile Include="src\add_samples.py" />
    <Compile Include="src\audio_utils.py" />
    <Compile Include="src\compare_models.py" />
    <Compile Include="src\concatenate_wavs.py" />
    <Compile Include="src\download_wavs.py" />
    <Compile Include="bootstrap\src\extract_training_samples.py" />
    <Compile Include="bootstrap\src\get_best_timestamp.py" />
    <Compile Include="src\generate_embeddings.py" />
    <Compile Include="src\LiveInferenceOrchestrator.py" />
    <Compile Include="bootstrap\src\make_csv.py" />
    <Compile Include="src\make_spectrograms.py" />
    <Compile Include="src\manual_samples_utils.py" />
    <Compile Include="bootstrap\src\merge_training_samples.py" />
    <Compile Include="src\mcp_server.py" />
    <Compile Include="src\model_inference.py" />
    <Compile Include="src\model_revisions.py" />
    <Compile Include="src\orcahello_inference.py" />
    <Compile Include="src\orcasite_feeds.py" />
    <Compile Include="src\podsai_inference.py" />
    <Compile Include="src\process_false_negatives.py" />
    <Compile Include="src\process_false_positives.py" />
    <Compile Include="src\process_testing_set_mispredictions.py" />
    <Compile Include="src\process_humpback_wavs.py" />
    <Compile Include="src\run_inference.py" />
    <Compile Include="src\spectrogram_visualizer.py" />
    <Compile Include="src\train_podsai_model.py" />
    <Compile Include="tests\conftest.py" />
    <Compile Include="tests\test_add_samples.py" />
    <Compile Include="tests\test_compare_models.py" />
    <Compile Include="tests\test_generate_embeddings.py" />
    <Compile Include="tests\test_download_wavs.py" />
    <Compile Include="tests\test_extract_training_samples.py" />
    <Compile Include="tests\test_get_best_timestamp.py" />
    <Compile Include="tests\test_inference_event_aggregation.py" />
    <Compile Include="tests\test_live_inference_orchestrator.py" />
    <Compile Include="tests\test_make_csv.py" />
    <Compile Include="tests\test_mcp_server.py" />
    <Compile Include="tests\test_podsai_inference.py" />
    <Compile Include="tests\test_process_false_negatives.py" />
    <Compile Include="tests\test_process_false_positives.py" />
    <Compile Include="tests\test_process_testing_set_mispredictions.py" />
    <Compile Include="tests\test_spectrogram_visualizer.py" />
    <Compile Include="tests\test_run_inference.py" />
    <Compile Include="tests\test_train_podsai_model.py" />
  </ItemGroup>
  <ItemGroup>
    <Folder Include="tests\" />
    <Folder Include="src\" />
    <Folder Include="bootstrap\" />
    <Folder Include="bootstrap\src\" />
  </ItemGroup>
  <ItemGroup>
    <Content Include="MCP_USAGE.md" />
    <Content Include="README.md" />
    <Content Include="requirements.txt" />
  </ItemGroup>
  <ItemGroup>
    <Interpreter Include=".venv\">
      <Id>.venv</Id>
      <Version>3.12</Version>
      <Description>.venv (Python 3.12 (64-bit))</Description>
      <InterpreterPath>Scripts\python.exe</InterpreterPath>
      <WindowsInterpreterPath>Scripts\pythonw.exe</WindowsInterpreterPath>
      <PathEnvironmentVariable>PYTHONPATH</PathEnvironmentVariable>
      <Architecture>X64</Architecture>
    </Interpreter>
  </ItemGroup>
  <Import Project="$(MSBuildExtensionsPath32)\Microsoft\VisualStudio\v$(VisualStudioVersion)\Python Tools\Microsoft.PythonTools.targets" />
