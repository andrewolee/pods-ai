<local:SamplesPageBase x:Class="DatasetManager.TestingSamplesPage"
      xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
      xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
      xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" 
      xmlns:d="http://schemas.microsoft.com/expression/blend/2008" 
      xmlns:local="clr-namespace:DatasetManager"
      mc:Ignorable="d" 
      d:DesignHeight="450" d:DesignWidth="800"
      Title="TestingSamplesPage">
    <Page.Resources>
        <local:AndBooleanConverter x:Key="AndBooleanConverter" />
    </Page.Resources>

    <Grid Margin="10">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="Auto"/>
            <ColumnDefinition Width="Auto"/>
            <ColumnDefinition Width="Auto"/>
            <ColumnDefinition Width="*"/>
        </Grid.ColumnDefinitions>
        <Button Grid.Row="0" Grid.Column="0" Content="Back" Click="Back_Click" Width="100" Margin="0,0,0,10"/>
        <TextBlock Grid.Row="0" Grid.Column="1" Grid.ColumnSpan="3" Text="{Binding Category, StringFormat='{}Testing samples for {0}'}" FontSize="20" FontWeight="Bold" Margin="0,0,0,10"/>
        <TextBlock Grid.Row="1" Grid.Column="0" Text="{Binding FalsePositiveCount, StringFormat='{}False positives: {0}'}" VerticalAlignment="Center" Margin="0,0,10,0"/>
        <Button Grid.Row="1" Grid.Column="1"
                Content="Analyze"
                Click="FindMispredictions_Click"
                IsEnabled="{Binding ElementName=SamplesGridControl, Path=InferenceEnabled}"
                Width="Auto"
                Margin="0,0,0,10"/>
        <local:SamplesGridControl Grid.Row="2" Grid.ColumnSpan="4" x:Name="SamplesGridControl" InferenceRequested="SamplesGrid_InferenceRequested" />
        <TextBlock Grid.Row="3" Grid.ColumnSpan="4" Text="Output:" FontSize="16" FontWeight="Bold" Margin="0,10,0,5"/>
        <local:LogViewerControl Grid.Row="4" Grid.ColumnSpan="4" x:Name="LogViewerControl"/>

        <StackPanel Grid.Row="5" Grid.Column="0" Orientation="Horizontal">
            <RadioButton x:Name="OneWeekRadio" Content="1w" Margin="0,0,15,0" GroupName="TimeRange" IsChecked="True"/>
            <RadioButton x:Name="TwoWeekRadio" Content="2w" Margin="0,0,15,0" GroupName="TimeRange"/>
            <RadioButton x:Name="OneMonthRadio" Content="1m" Margin="0,0,15,0" GroupName="TimeRange"/>
        </StackPanel>
        <Button Grid.Row="5" Grid.Column="1"
                Content="Find more false positives"
                Click="MoreFalsePositives_Click"
                Width="Auto"
                Margin="0,0,0,10">
            <Button.IsEnabled>
                <MultiBinding Converter="{StaticResource AndBooleanConverter}">
                    <Binding ElementName="SamplesGridControl" Path="InferenceEnabled"/>
                    <Binding Path="IsNotResident"/>
                </MultiBinding>
            </Button.IsEnabled>
        </Button>
        <Button Grid.Row="5" Grid.Column="2"
                Content="Find more false negatives"
                Click="MoreFalseNegatives_Click"
                IsEnabled="{Binding ElementName=SamplesGridControl, Path=InferenceEnabled}"
                Width="Auto"
                Margin="0,0,10,10">
            <Button.Style>
                <Style TargetType="Button">
                    <Setter Property="Visibility" Value="Collapsed"/>
                    <Style.Triggers>
                        <DataTrigger Binding="{Binding Category}" Value="resident">
                            <Setter Property="Visibility" Value="Visible"/>
                        </DataTrigger>
                    </Style.Triggers>
                </Style>
            </Button.Style>
        </Button>
        <Button Grid.Row="5" Grid.Column="3"
                Content="Update moderated tags"
                Click="UpdateModeratedTags_Click"
                Width="Auto"
                IsEnabled="{Binding Path=EnableUpdateTags}"
                Margin="0,0,0,10"/>
    </Grid>
</local:SamplesPageBase>
